        "inputText": "={{ $json.text }}",
        "categories": {
          "categories": [
            {
              "category": "Customer Support ",
              "description": "Texts where the user asks questions about Visual Studio Code, including reporting technical problems, troubleshooting errors, fixing installation or performance issues, configuring settings, or understanding how specific VS Code features work. This category also includes general FAQ-style inquiries about VS Code capabilities, limitations, or expected behavior, even when no error is reported.  Examples  “VS Code shows [Unsupported] in the title bar after installation. How do I restore a supported setup?”  “Can VS Code be launched without GPU acceleration if it opens with a blank window?”"
            },
            {
              "category": "Other ",
              "description": "Texts that are not focused on resolving a technical issue. This includes general questions, conceptual explanations, planning, writing requests, opinions, or casual discussion without any system failure or debugging context.  Example  “What is the difference between tokenization and vector embeddings in simple terms?”"
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "Please classify the text provided by the user into one of the following categories: {categories}, and use the provided formatting instructions below. Don't explain, and only output the json."
        }
      },
